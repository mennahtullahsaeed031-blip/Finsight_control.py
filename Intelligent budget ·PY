# INTELLIGENT INSIGHTS
# ══════════════════════════════════════════════════════════════════════════════
def generate_intelligent_insights(result: dict) -> list:
    insights = []
    sc        = result["scenario_details"]
    gv        = result["growth_validation"]
    ha        = result["historical_analysis"]
    ba        = result["benchmark_alerts"]
    is_d      = result["master_budget"]["income_statement"]

    # CAGR vs Proposed
    insights.append(
        f"📊 Historical Revenue CAGR: {ha['cagr'].get('revenue', 0):.1f}% | "
        f"Proposed Growth: {sc['revenue_growth']*100:.1f}% | "
        f"Verdict: {gv['verdict']}"
    )

    # Scenario logic
    insights.append(
        f"🎯 Scenario '{result['scenario_used']}' ({sc.get('probability','—')}): "
        f"{sc['description']}"
    )

    # Benchmark summary
    ok_count   = sum(1 for a in ba if a["severity"] == "OK")
    warn_count = sum(1 for a in ba if a["severity"] != "OK")
    insights.append(
        f"🏭 Benchmark Check: {ok_count} metrics within range, "
        f"{warn_count} need review."
    )

    # Warnings
    for alert in ba:
        if alert["severity"] != "OK":
            insights.append(f"   ⚠️ {alert['message']}")

    # Financial summary
    insights.append(
        f"💰 Budgeted P&L: Revenue=${is_d['annual_revenue']/1e6:.2f}M | "
        f"GM={is_d['avg_gm']:.1f}% | NM={is_d['avg_nm']:.1f}%"
    )

    for w in gv.get("warnings", []):
        insights.append(f"   {w}")

    return insights
