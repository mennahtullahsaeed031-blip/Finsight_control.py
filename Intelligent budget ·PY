# STEP 5: SCENARIO ENGINE
# Builds 3 scenarios: Base / Best / Worst
# Validated against CAGR + GDP + Industry Growth
# ══════════════════════════════════════════════════════════════════════════════

def validate_growth_assumption(
    proposed_growth: float,
    historical_cagr: float,
    gdp_growth:      float,
    industry_growth: float,
) -> dict:
    """
    Validates if the proposed revenue growth is realistic.
    Warns if growth >> CAGR or GDP.
    CMA / FP&A best practice: growth should be anchored to historical data.
    """
    warnings    = []
    is_realistic = True

    # Rule 1: proposed > 2x historical CAGR → warning
    if historical_cagr > 0 and proposed_growth > historical_cagr * 2:
        warnings.append(
            f"⚠️ Proposed growth ({proposed_growth*100:.1f}%) is more than 2x "
            f"historical CAGR ({historical_cagr*100:.1f}%). "
            f"Justify with specific business drivers."
        )
        is_realistic = False

    # Rule 2: proposed > GDP * 5 → warning
    if gdp_growth > 0 and proposed_growth > gdp_growth * 5:
        warnings.append(
            f"⚠️ Proposed growth ({proposed_growth*100:.1f}%) is >5x GDP growth "
            f"({gdp_growth*100:.1f}%). Requires strong competitive advantage."
        )

    # Rule 3: proposed > industry_growth * 3 → warning
    if industry_growth > 0 and proposed_growth > industry_growth * 3:
        warnings.append(
            f"⚠️ Proposed growth ({proposed_growth*100:.1f}%) is >3x industry growth "
            f"({industry_growth*100:.1f}%). "
            f"May imply unrealistic market share gain."
        )

    return {
        "proposed_growth":  round(proposed_growth * 100, 1),
        "historical_cagr":  round(historical_cagr * 100, 1),
        "gdp_growth":       round(gdp_growth * 100, 1),
        "industry_growth":  round(industry_growth * 100, 1),
        "is_realistic":     is_realistic,
        "warnings":         warnings,
        "verdict":          "Realistic ✅" if is_realistic and not warnings else "Review Needed ⚠️",
    }


def build_scenarios(
    historical_analysis: dict,
    economic_assumptions: dict,
    drivers:             dict,
) -> dict:
    """
    3 Scenarios anchored to CAGR + GDP + Drivers:
    Base:  CAGR + GDP adjustment + drivers
    Best:  Base + upside from drivers
    Worst: Base - downside from risks
    """
    hist_rev_cagr = historical_analysis["cagr_raw"].get("revenue", 0.10)
    gdp           = economic_assumptions["gdp_growth"]
    industry_g    = economic_assumptions["industry_growth"]
    inflation     = economic_assumptions["inflation_rate"]
    rev_uplift    = drivers["total_revenue_uplift"]

    # Base: Historical CAGR adjusted for GDP and industry
    base_growth = (hist_rev_cagr * 0.6 +    # 60% weight on history
                   gdp           * 0.2 +    # 20% weight on GDP
                   industry_g    * 0.2)     # 20% weight on industry
    base_growth += rev_uplift               # add business drivers

    # Best: Base + 30-50% upside
    best_growth  = base_growth * 1.35 + rev_uplift * 0.5

    # Worst: Base - 30-50% downside + inflation impact
    worst_growth = base_growth * 0.60 - (inflation * 0.1)
    worst_growth = max(worst_growth, -0.10)   # floor at -10%

    scenarios = {
        "Base": {
            "revenue_growth":  round(base_growth, 4),
            "inflation_rate":  inflation,
            "description":     f"Historical CAGR ({hist_rev_cagr*100:.1f}%) weighted with GDP & industry",
            "probability":     "50%",
        },
        "Best": {
            "revenue_growth":  round(best_growth, 4),
            "inflation_rate":  inflation * 0.85,
            "description":     "Above-CAGR growth — new products/branches succeed, market expands",
            "probability":     "25%",
        },
        "Worst": {
            "revenue_growth":  round(worst_growth, 4),
            "inflation_rate":  inflation * 1.20,
            "description":     "Below-CAGR — cost pressures, weak demand, or macro risks materialize",
            "probability":     "25%",
        },
    }

    # Validate each scenario
    for name, sc in scenarios.items():
        sc["validation"] = validate_growth_assumption(
            sc["revenue_growth"], hist_rev_cagr, gdp, industry_g
        )

    return scenarios


