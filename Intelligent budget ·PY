# STEP 6: BENCHMARK VALIDATION
# ══════════════════════════════════════════════════════════════════════════════
def validate_against_benchmarks(
    proposed_assumptions: dict,
    business_profile:     dict,
) -> list:
    """
    Checks proposed budget assumptions against industry benchmarks.
    Returns list of alerts/warnings.
    """
    alerts     = []
    benchmarks = business_profile["benchmarks"]
    industry   = business_profile["industry"]

    checks = [
        ("gross_margin",  proposed_assumptions.get("gross_margin_pct", 35),
         "Gross Margin", "%"),
        ("net_margin",    proposed_assumptions.get("net_margin_pct", 10),
         "Net Margin", "%"),
        ("cogs_pct",      proposed_assumptions.get("cogs_pct", 0.55) * 100,
         "COGS % of Revenue", "%"),
        ("payroll_pct",   proposed_assumptions.get("payroll_pct", 15),
         "Payroll % of Revenue", "%"),
        ("marketing_pct", proposed_assumptions.get("marketing_pct", 0.08) * 100,
         "Marketing % of Revenue", "%"),
        ("revenue_growth",proposed_assumptions.get("revenue_growth", 0.10) * 100,
         "Revenue Growth", "%"),
    ]

    for key, value, label, unit in checks:
        if key not in benchmarks:
            continue
        low, high = benchmarks[key]
        if value < low:
            alerts.append({
                "type":      "Below Benchmark",
                "severity":  "Warning",
                "metric":    label,
                "value":     f"{value:.1f}{unit}",
                "benchmark": f"{low}-{high}{unit} ({industry})",
                "message":   f"{label} ({value:.1f}%) is below the {industry} benchmark ({low}-{high}%). Review your assumptions.",
            })
        elif value > high:
            alerts.append({
                "type":      "Above Benchmark",
                "severity":  "Warning" if value < high * 1.5 else "Alert",
                "metric":    label,
                "value":     f"{value:.1f}{unit}",
                "benchmark": f"{low}-{high}{unit} ({industry})",
                "message":   f"{label} ({value:.1f}%) exceeds {industry} benchmark ({low}-{high}%). Verify if justified by competitive advantage.",
            })
        else:
            alerts.append({
                "type":      "Within Benchmark",
                "severity":  "OK",
                "metric":    label,
                "value":     f"{value:.1f}{unit}",
                "benchmark": f"{low}-{high}{unit} ({industry})",
                "message":   f"✅ {label} ({value:.1f}%) within {industry} benchmark.",
            })

    return alerts


