# STEP 4: BUSINESS DRIVERS
# ══════════════════════════════════════════════════════════════════════════════
def create_business_drivers(
    new_products:        bool  = False,
    new_products_rev_pct:float = 0.0,    # % إضافة على الـ revenue
    new_branches:        bool  = False,
    new_branches_rev_pct:float = 0.0,
    new_hires:           int   = 0,      # عدد موظفين جدد
    avg_new_hire_salary: float = 15_000,
    marketing_expansion: bool  = False,
    marketing_extra_pct: float = 0.0,    # extra % of revenue
    capex_expansion:     float = 0.0,    # extra CapEx
) -> dict:
    total_revenue_uplift = new_products_rev_pct + new_branches_rev_pct
    extra_payroll        = new_hires * avg_new_hire_salary * 12
    extra_marketing_pct  = marketing_extra_pct if marketing_expansion else 0.0

    return {
        "new_products":         new_products,
        "new_products_rev_pct": new_products_rev_pct,
        "new_branches":         new_branches,
        "new_branches_rev_pct": new_branches_rev_pct,
        "new_hires":            new_hires,
        "avg_new_hire_salary":  avg_new_hire_salary,
        "extra_payroll_annual": extra_payroll,
        "marketing_expansion":  marketing_expansion,
        "extra_marketing_pct":  extra_marketing_pct,
        "capex_expansion":      capex_expansion,
        "total_revenue_uplift": total_revenue_uplift,
    }


