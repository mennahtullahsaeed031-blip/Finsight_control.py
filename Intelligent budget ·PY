# STEP 7: AUTO BUILD — generates full Master Budget from intelligent inputs
# ══════════════════════════════════════════════════════════════════════════════
def build_intelligent_budget(
    business_profile:     dict,
    historical_analysis:  dict,
    economic_assumptions: dict,
    drivers:              dict,
    scenario_name:        str   = "Base",
    base_assumptions:     dict  = None,
) -> dict:
    """
    Builds Master Budget automatically from intelligent inputs.
    Combines: CAGR + GDP + Drivers + Scenarios → Full Budget
    """
    scenarios = build_scenarios(historical_analysis, economic_assumptions, drivers)
    scenario  = scenarios.get(scenario_name, scenarios["Base"])

    # Build assumptions by combining defaults + intelligent inputs
    last_revenue = historical_analysis.get("last_revenue", 1_000_000)

    smart_assumptions = {
        **(base_assumptions or DEFAULT_ASSUMPTIONS),

        # Revenue: from historical last year
        "base_revenue":      last_revenue,
        "revenue_growth":    scenario["revenue_growth"],

        # Inflation adjustments
        "inflation_rate":    scenario["inflation_rate"],
        "salary_growth":     economic_assumptions["inflation_rate"] * 0.7,  # wages track 70% of inflation

        # Interest rate from economic assumptions
        "interest_rate":     economic_assumptions["interest_rate"],

        # Business drivers impact
        "avg_salary_monthly": (
            (base_assumptions or DEFAULT_ASSUMPTIONS).get("avg_salary_monthly", 15_000)
            + (drivers["extra_payroll_annual"] / max(
                (base_assumptions or DEFAULT_ASSUMPTIONS).get("base_headcount", 50) + drivers["new_hires"], 1
            ) / 12)
        ),
        "base_headcount": (
            (base_assumptions or DEFAULT_ASSUMPTIONS).get("base_headcount", 50)
            + drivers["new_hires"]
        ),
        "marketing_pct": (
            (base_assumptions or DEFAULT_ASSUMPTIONS).get("marketing_pct", 0.08)
            + drivers["extra_marketing_pct"]
        ),
        "capex_annual": (
            (base_assumptions or DEFAULT_ASSUMPTIONS).get("capex_annual", 500_000)
            + drivers["capex_expansion"]
        ),
    }

    # Build the master budget
    master = build_master_budget(smart_assumptions)

    # Benchmark validation
    is_d        = master["income_statement"]
    annual_rev  = is_d["annual_revenue"]
    annual_pay  = (smart_assumptions["base_headcount"]
                   * smart_assumptions["avg_salary_monthly"]
                   * 12 * (1 + smart_assumptions["salary_growth"]))

    validation_assumptions = {
        "gross_margin_pct":  is_d["avg_gm"],
        "net_margin_pct":    is_d["avg_nm"],
        "cogs_pct":          master["cogs"]["annual"] / annual_rev if annual_rev else 0,
        "payroll_pct":       annual_pay / annual_rev * 100 if annual_rev else 0,
        "marketing_pct":     smart_assumptions["marketing_pct"],
        "revenue_growth":    scenario["revenue_growth"],
    }
    benchmark_alerts = validate_against_benchmarks(
        validation_assumptions, business_profile
    )

    # Growth validation
    growth_validation = validate_growth_assumption(
        scenario["revenue_growth"],
        historical_analysis["cagr_raw"].get("revenue", 0.10),
        economic_assumptions["gdp_growth"],
        economic_assumptions["industry_growth"],
    )

    return {
        "master_budget":      master,
        "scenario_used":      scenario_name,
        "scenario_details":   scenario,
        "all_scenarios":      scenarios,
        "benchmark_alerts":   benchmark_alerts,
        "growth_validation":  growth_validation,
        "smart_assumptions":  smart_assumptions,
        "business_profile":   business_profile,
        "historical_analysis":historical_analysis,
    }


