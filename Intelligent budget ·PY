# STEP 2: HISTORICAL DATA ANALYSIS
# Input: 3 years of actuals (Revenue, COGS, GP, OpEx, Net Income)
# Output: CAGR for each metric
# ══════════════════════════════════════════════════════════════════════════════
def calculate_cagr(start_value: float, end_value: float, years: int) -> float:
    """
    CAGR = (End Value / Start Value)^(1/n) - 1
    Academic formula — CMA/CFA standard
    """
    if start_value <= 0 or end_value <= 0 or years <= 0:
        return 0.0
    return (end_value / start_value) ** (1 / years) - 1


def analyze_historical_data(historical: dict) -> dict:
    """
    Input: {
        "2023": {"revenue": 1M, "cogs": 600K, "gross_profit": 400K,
                 "opex": 200K, "net_income": 150K},
        "2024": {...},
        "2025": {...},
    }
    Output: CAGR + Trends + Margins
    """
    years = sorted(historical.keys())
    if len(years) < 2:
        return {"error": "Need at least 2 years of data", "cagr": {}}

    n       = len(years) - 1
    first   = historical[years[0]]
    last    = historical[years[-1]]

    # CAGR for each metric
    cagr = {
        "revenue":      calculate_cagr(first.get("revenue",1),      last.get("revenue",1),      n),
        "gross_profit": calculate_cagr(first.get("gross_profit",1),  last.get("gross_profit",1), n),
        "net_income":   calculate_cagr(first.get("net_income",0.01), last.get("net_income",0.01),n),
        "cogs":         calculate_cagr(first.get("cogs",1),          last.get("cogs",1),         n),
        "opex":         calculate_cagr(first.get("opex",1),          last.get("opex",1),         n),
    }

    # Margin trends
    margins = {}
    for yr in years:
        d   = historical[yr]
        rev = d.get("revenue", 1)
        margins[yr] = {
            "gross_margin": d.get("gross_profit", 0) / rev * 100 if rev else 0,
            "net_margin":   d.get("net_income",   0) / rev * 100 if rev else 0,
            "opex_ratio":   d.get("opex",         0) / rev * 100 if rev else 0,
        }

    # Trend direction
    rev_values = [historical[y].get("revenue", 0) for y in years]
    trend = "Growing" if rev_values[-1] > rev_values[0] else "Declining"

    return {
        "years":       years,
        "cagr":        {k: round(v * 100, 2) for k, v in cagr.items()},
        "cagr_raw":    cagr,
        "margins":     margins,
        "trend":       trend,
        "last_revenue":last.get("revenue", 0),
        "last_net":    last.get("net_income", 0),
    }


